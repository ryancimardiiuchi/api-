
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String    @unique
  name              String
  telefone          String
  senha             String
  emailVerificado   Boolean   @default(false)
  codigoVerificacao String?
  codigoExpira      DateTime?
  role String  @default("cliente")
  cart Cart?
  pedidos   Pedido[]
  enderecos Endereco[]
 mensagens Mensagem[]
}

model Mensagem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  texto      String
  remetente  String
  createdAt  DateTime @default(now())

  clienteId  String   @db.ObjectId

  cliente User @relation(fields: [clienteId], references: [id])
}

model Cart {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  UserId String @unique @db.ObjectId

  user User @relation(fields: [UserId], references: [id])

  itens CartItem[]
}

model CartItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  CartId    String @db.ObjectId
  ServicoId String @db.ObjectId

  quantidade Float
  preco      Float

  cart    Cart     @relation(fields: [CartId], references: [id])
  servico Servicos @relation(fields: [ServicoId], references: [id])
}

model Servicos {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  nome        String
  descricao   String
  preco       Float
  itensCart   CartItem[]
  itensPedido PedidoItem[]
}

model Pedido {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  UserId         String       @db.ObjectId
  EnderecoId     String       @db.ObjectId
  valor          Float
  status         String       @default("coleta agendada")
  dataPedido     DateTime     @default(now())
  dataColeta     DateTime?
  horarioColeta  String?
  formaPagamento String?
  itensPedido    PedidoItem[]
  user           User         @relation(fields: [UserId], references: [id])
  endereco       Endereco     @relation(fields: [EnderecoId], references: [id])
}

model Endereco {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  UserId      String   @db.ObjectId
  rua         String
  numero      String
  complemento String?
  bairro      String
  cep         String
  user        User     @relation(fields: [UserId], references: [id])
  pedidos     Pedido[]
}

model PedidoItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  PedidoId  String @db.ObjectId
  ServicoId String @db.ObjectId

  quantidade Float
  preco      Float

  pedido  Pedido   @relation(fields: [PedidoId], references: [id])
  servico Servicos @relation(fields: [ServicoId], references: [id])
}
